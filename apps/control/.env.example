# Go Control Plane + Control PostgreSQL
# cp .env.control.example .env.control

SERVICE_NAME=control-plane
CONTROL_PLANE_SERVER_HTTP_ADDR=:8080
CONTROL_DATABASE_URL=postgresql://control:change-this-control-password@postgres-control:5432/control
CONTROL_PLANE_SECURITY_ALLOW_MEMORY=false
CONTROL_PLANE_SECURITY_AUTH_ENABLED=true
CONTROL_PLANE_SECURITY_COOKIE_SECURE=false
CONTROL_PLANE_SECURITY_SESSION_HOURS=720
CONTROL_PLANE_SECURITY_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CONTROL_PLANE_SECURITY_MODEL_ENCRYPTION_KEY=
CONTROL_PLANE_SECURITY_EXECUTION_ENCRYPTION_KEY=
CONTROL_PLANE_SECURITY_INTERNAL_TOKEN=change-this-platform-internal-token

POSTGRES_CONTROL_USER=control
POSTGRES_CONTROL_PASSWORD=change-this-control-password
POSTGRES_CONTROL_DB=control
# PostgreSQL container aliases
POSTGRES_USER=control
POSTGRES_PASSWORD=change-this-control-password
POSTGRES_DB=control

CONTROL_PLANE_REDIS_ADDR=redis:6379
CONTROL_PLANE_REDIS_DB=0
CONTROL_PLANE_REDIS_USERNAME=default
CONTROL_PLANE_REDIS_PASSWORD=change-this-redis-password
CONTROL_PLANE_REDIS_KEY_PREFIX=control:
CONTROL_PLANE_MQ_ENDPOINT=rocketmq-proxy:8081
CONTROL_PLANE_SERVER_ENVIRONMENT=dev
CONTROL_PLANE_MQ_ENABLED=true
CONTROL_PLANE_MQ_TLS_ENABLED=false
CONTROL_PLANE_MQ_ACCESS_KEY=
CONTROL_PLANE_MQ_SECRET_KEY=
CONTROL_PLANE_MQ_NAMESPACE=
CONTROL_PLANE_MQ_TOPICS_TASKS=agent-dev-runtime-tasks
CONTROL_PLANE_MQ_TOPICS_CONTROL=agent-dev-runtime-control
CONTROL_PLANE_MQ_TOPICS_EVENTS=agent-dev-runtime-events
CONTROL_PLANE_MQ_TOPICS_MEMORY=agent-dev-memory-tasks
CONTROL_PLANE_MQ_GROUPS_PROJECTION=agent-dev-control-projection
CONTROL_PLANE_OBJECT_STORAGE_PROVIDERS_0_TYPE=s3
CONTROL_PLANE_OBJECT_STORAGE_PROVIDERS_0_ENDPOINT=http://rustfs:9000
# 客户端访问预签名 URL 时使用的地址，部署到远程主机时改为实际可访问域名。
CONTROL_PLANE_OBJECT_STORAGE_PROVIDERS_0_PUBLIC_ENDPOINT=http://localhost:9000
CONTROL_PLANE_OBJECT_STORAGE_PROVIDERS_0_BUCKET=agent-artifacts
CONTROL_PLANE_OBJECT_STORAGE_PROVIDERS_0_REGION=us-east-1
CONTROL_PLANE_OBJECT_STORAGE_PROVIDERS_0_ACCESS_KEY=change-this-rustfs-access-key
CONTROL_PLANE_OBJECT_STORAGE_PROVIDERS_0_SECRET_KEY=change-this-rustfs-secret-key

CONTROL_PLANE_PORT=8080
