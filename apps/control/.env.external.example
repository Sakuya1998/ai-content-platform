# 外部基础设施模式：Go Control Plane
# 复制为 .env.control.external 后填写真实值。
CONTROL_PLANE_IMAGE=novel-agent-control-plane:local
CONTROL_PLANE_SERVER_NAME=control
CONTROL_PLANE_SERVER_HTTP_ADDR=:8080
CONTROL_DATABASE_URL=postgresql://control:change-me@control-db.example.com:5432/control
CONTROL_PLANE_SECURITY_ALLOW_MEMORY=false
CONTROL_PLANE_SECURITY_AUTH_ENABLED=true
CONTROL_PLANE_SECURITY_COOKIE_SECURE=true
CONTROL_PLANE_SECURITY_SESSION_HOURS=720
CONTROL_PLANE_SECURITY_ALLOWED_ORIGINS=https://studio.example.com
CONTROL_PLANE_SECURITY_MODEL_ENCRYPTION_KEY=
CONTROL_PLANE_SECURITY_EXECUTION_ENCRYPTION_KEY=
CONTROL_PLANE_SECURITY_INTERNAL_TOKEN=change-me
CONTROL_PLANE_REDIS_ADDR=redis.example.com:6379
CONTROL_PLANE_REDIS_DB=0
CONTROL_PLANE_REDIS_KEY_PREFIX=control:
CONTROL_PLANE_REDIS_USERNAME=default
CONTROL_PLANE_REDIS_PASSWORD=change-me
CONTROL_PLANE_MQ_TYPE=rocketmq
CONTROL_PLANE_MQ_ENDPOINT=rocketmq-proxy.example.com:8081
CONTROL_PLANE_MQ_TLS_ENABLED=false
CONTROL_PLANE_MQ_ACCESS_KEY=
CONTROL_PLANE_MQ_SECRET_KEY=
CONTROL_PLANE_MQ_NAMESPACE=
CONTROL_PLANE_SERVER_ENVIRONMENT=staging
CONTROL_PLANE_MQ_ENABLED=true
CONTROL_PLANE_MQ_TOPICS_TASKS=agent-staging-runtime-tasks
CONTROL_PLANE_MQ_TOPICS_CONTROL=agent-staging-runtime-control
CONTROL_PLANE_MQ_TOPICS_EVENTS=agent-staging-runtime-events
CONTROL_PLANE_MQ_TOPICS_MEMORY=agent-staging-memory-tasks
CONTROL_PLANE_MQ_GROUPS_PROJECTION=agent-staging-control-projection
CONTROL_PLANE_OBJECT_STORAGE_DEFAULT=s3
CONTROL_PLANE_OBJECT_STORAGE_PROVIDERS_0_TYPE=s3
CONTROL_PLANE_OBJECT_STORAGE_PROVIDERS_0_ENDPOINT=https://rustfs.example.com
CONTROL_PLANE_OBJECT_STORAGE_PROVIDERS_0_PUBLIC_ENDPOINT=https://rustfs.example.com
CONTROL_PLANE_OBJECT_STORAGE_PROVIDERS_0_REGION=us-east-1
CONTROL_PLANE_OBJECT_STORAGE_PROVIDERS_0_BUCKET=agent-artifacts
CONTROL_PLANE_OBJECT_STORAGE_PROVIDERS_0_ACCESS_KEY=change-me
CONTROL_PLANE_OBJECT_STORAGE_PROVIDERS_0_SECRET_KEY=change-me
CONTROL_PLANE_PORT=8080
