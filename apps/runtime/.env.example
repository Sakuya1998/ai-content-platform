# Python Agent Runtime + Runtime PostgreSQL/pgvector + shared infrastructure
# cp .env.runtime.example .env.runtime

RUNTIME_SERVICE_NAME=runtime
RUNTIME_HOST=0.0.0.0
RUNTIME_PORT=8000
RUNTIME_DATABASE_URL=postgresql://runtime:change-this-runtime-password@postgres-runtime:5432/runtime
RUNTIME_REDIS_URL=redis://:change-this-redis-password@redis:6379/0
RUNTIME_REDIS_KEY_PREFIX=runtime:
RUNTIME_ROCKETMQ_ENDPOINT=rocketmq-proxy:8081
RUNTIME_ROCKETMQ_TLS_ENABLED=false
RUNTIME_ROCKETMQ_ACCESS_KEY=
RUNTIME_ROCKETMQ_SECRET_KEY=
RUNTIME_ROCKETMQ_NAMESPACE=
RUNTIME_ENVIRONMENT=dev
RUNTIME_ROCKETMQ_TASK_TOPIC=agent-dev-runtime-tasks
RUNTIME_ROCKETMQ_CONTROL_TOPIC=agent-dev-runtime-control
RUNTIME_ROCKETMQ_EVENT_TOPIC=agent-dev-runtime-events
RUNTIME_ROCKETMQ_MEMORY_TOPIC=agent-dev-memory-tasks
RUNTIME_ROCKETMQ_DISPATCH_GROUP=agent-dev-runtime-dispatch
RUNTIME_ROCKETMQ_CONTROL_GROUP=agent-dev-runtime-control
RUNTIME_ROCKETMQ_MEMORY_GROUP=agent-dev-memory-worker
RUNTIME_ROCKETMQ_MEMORY_SCHEDULER_GROUP=agent-dev-memory-scheduler
# Trusted async module:function handlers; leave workers disabled until configured.
RUNTIME_WORKER_HANDLER=agent_runtime.execution.handlers:generate_content
RUNTIME_MEMORY_HANDLER=agent_runtime.execution.handlers:refresh_memory
RUNTIME_LLM_PROVIDER=openai_compatible
RUNTIME_LLM_MODEL=
RUNTIME_LLM_BASE_URL=
RUNTIME_LLM_API_KEY=
RUNTIME_ANALYSIS_MODEL=
RUNTIME_LLM_MAX_TOKENS=4096
RUNTIME_LLM_TIMEOUT_SECONDS=120
RUNTIME_MEDIA_POLL_SECONDS=5
RUNTIME_MEDIA_POLL_TIMEOUT_SECONDS=3600
RUNTIME_FFMPEG_BIN=ffmpeg
RUNTIME_FFPROBE_BIN=ffprobe
RUNTIME_COMPOSE_TIMEOUT_SECONDS=300
RUNTIME_COMPOSE_THREADS=2
RUNTIME_COMPOSE_INPUT_MAX_BYTES=268435456
RUNTIME_MAX_PROJECT_TOKENS=0
RUNTIME_EMBEDDING_MODEL=
RUNTIME_EMBEDDING_BASE_URL=
RUNTIME_EMBEDDING_API_KEY=
RUNTIME_EXECUTION_ENCRYPTION_KEY=
RUNTIME_CONTEXT_TOKEN_BUDGET=12000
RUNTIME_WORKER_MAX_ATTEMPTS=3
RUNTIME_WORKER_RETRY_SECONDS=30
RUNTIME_OBJECT_STORAGE_ENDPOINT=http://rustfs:9000
RUNTIME_OBJECT_STORAGE_BUCKET=agent-artifacts
RUNTIME_OBJECT_STORAGE_REGION=us-east-1
RUNTIME_ARTIFACT_MAX_BYTES=52428800
RUNTIME_OBJECT_STORAGE_ACCESS_KEY=change-this-rustfs-access-key
RUNTIME_OBJECT_STORAGE_SECRET_KEY=change-this-rustfs-secret-key
RUNTIME_WORKER_ID=runtime-local
RUNTIME_JOB_LEASE_SECONDS=60
RUNTIME_JOB_HEARTBEAT_SECONDS=15

POSTGRES_RUNTIME_USER=runtime
POSTGRES_RUNTIME_PASSWORD=change-this-runtime-password
POSTGRES_RUNTIME_DB=runtime
POSTGRES_USER=runtime
POSTGRES_PASSWORD=change-this-runtime-password
POSTGRES_DB=runtime

REDIS_PASSWORD=change-this-redis-password
RUSTFS_ACCESS_KEY=change-this-rustfs-access-key
RUSTFS_SECRET_KEY=change-this-rustfs-secret-key
RUSTFS_API_PORT=9000
RUSTFS_CONSOLE_PORT=9001

RUNTIME_IMAGE=novel-agent-runtime:local
