{
  "additionalProperties": false,
  "description": "An ordered Runtime event that can be projected idempotently by Go.",
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "occurred_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Occurred At"
    },
    "causation_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Causation Id"
    },
    "event_id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Event Id",
      "type": "string"
    },
    "event_type": {
      "maxLength": 120,
      "minLength": 1,
      "title": "Event Type",
      "type": "string"
    },
    "workspace_id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Workspace Id",
      "type": "string"
    },
    "project_id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Project Id",
      "type": "string"
    },
    "job_id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Job Id",
      "type": "string"
    },
    "workflow_run_id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Workflow Run Id",
      "type": "string"
    },
    "sequence": {
      "minimum": 1,
      "title": "Sequence",
      "type": "integer"
    },
    "operation_id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Operation Id",
      "type": "string"
    },
    "trace_id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Trace Id",
      "type": "string"
    },
    "payload": {
      "additionalProperties": true,
      "title": "Payload",
      "type": "object"
    }
  },
  "required": [
    "event_id",
    "event_type",
    "workspace_id",
    "project_id",
    "job_id",
    "workflow_run_id",
    "sequence",
    "operation_id",
    "trace_id"
  ],
  "title": "RuntimeEvent",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-platform.dev/contracts/event.schema.json"
}
